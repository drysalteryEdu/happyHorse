{
  "rewrites": [
    { "source": "/hanziBoard/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/hanziBoard/data/(.*)",   "destination": "/data/$1"   },
    { "source": "/hanziBoard(.*)",         "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install"
}
